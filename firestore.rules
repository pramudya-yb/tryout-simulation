rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Data peserta CPNS
    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read:   if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Data instansi pemerintah (K/L/Pemda)
    match /instansi/{instansiSlug} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.createdBy == request.auth.uid;
      allow delete: if false;
    }

    // Username unik untuk admin/pengawas
    match /admin_usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Bank soal SKD & SKB
    // - Admin bisa kelola soal miliknya
    // - Peserta bisa baca soal saat ujian berlangsung
    match /bank_soal/{soalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.adminId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.adminId == request.auth.uid;
    }

    // Paket ujian SKD / SKB
    // - Admin bisa baca paket miliknya
    // - Peserta bisa baca paket yang sudah dipublikasikan
    match /paket_ujian/{paketId} {
      allow read: if isSignedIn()
        && (resource.data.adminId == request.auth.uid
            || resource.data.isPublished == true);
      allow create: if isSignedIn()
        && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.adminId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.adminId == request.auth.uid;
    }

    // Hasil ujian SKD / SKB
    // - Admin bisa baca hasil ujian yang dikelolanya
    // - Peserta hanya bisa baca hasil ujian miliknya sendiri
    match /hasil_ujian/{hasilId} {
      allow read: if isSignedIn()
        && (resource.data.adminId == request.auth.uid
            || resource.data.pesertaId == request.auth.uid);
      // Peserta membuat hasil ujian atas namanya sendiri
      allow create: if isSignedIn()
        && request.resource.data.pesertaId == request.auth.uid;
      allow update, delete: if false;
    }

    // Akses ujian ulang (jika peserta diizinkan mencoba kembali)
    // - Admin & peserta bisa baca akses miliknya
    // - Hanya admin yang bisa membuat akses ujian ulang
    // - Admin bisa update; peserta hanya bisa menandai sudah digunakan
    match /akses_ujian_ulang/{aksesId} {
      allow read: if isSignedIn()
        && (resource.data.pesertaId == request.auth.uid
            || resource.data.adminId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.adminId == request.auth.uid
            || resource.data.pesertaId == request.auth.uid);
      allow delete: if false;
    }
  }
}
